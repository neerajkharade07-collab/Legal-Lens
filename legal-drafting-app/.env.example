# Legal Lens — Legal Drafting app (Vite). All optional. No secrets belong here:
# anything in a VITE_ variable is visible in the browser.

# Backend the dev server proxies /api to (npm run dev / npm run preview).
DEV_API_PROXY_TARGET=http://localhost:5000

# Only if the app must call a backend on ANOTHER origin directly (normally leave
# unset: production serves the API on the same origin under /api).
# VITE_API_BASE_URL=https://api.example.com/api

# Main Legal Lens website. Defaults: "/" in production (same site),
# http://127.0.0.1:5500/ during `npm run dev` (VS Code Live Server).
# VITE_MAIN_SITE_URL=http://127.0.0.1:5500/
